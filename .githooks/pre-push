#!/usr/bin/env bash
# pre-push — the last gate before anything leaves the machine.
#
# The pre-commit hook protects the commit. This protects the BRANCH: what a push
# would make true about the world. Two rules live here, and both are about
# `main` and `validated` because those two names carry promises.
#
#   AIGF_ALLOW_MAIN_PUSH=1     for the one-off that genuinely must go to main
#   AIGF_ALLOW_FORCE_PUSH=1    for a history rewrite, which is never casual
set -uo pipefail

BOLD=$'\033[1m'; RED=$'\033[31m'; YEL=$'\033[33m'; OFF=$'\033[0m'
say() { printf '%s\n' "$*"; }
refuse() { printf '%s  REFUSED: %s%s\n' "$RED" "$1" "$OFF" >&2; }
FAIL=0

ZERO=0000000000000000000000000000000000000000
ALLOW_MAIN="${AIGF_ALLOW_MAIN_PUSH:-0}"
ALLOW_FORCE="${AIGF_ALLOW_FORCE_PUSH:-0}"

while read -r _local_ref _local_sha _remote_ref _remote_sha; do
  BRANCH="${_remote_ref#refs/heads/}"

  # -- RULES/06: main is where work lands. It reaches the public through
  # -- validated, and a direct push to main skips the only human checkpoint.
  if [ "$BRANCH" = "main" ] && [ "$ALLOW_MAIN" != "1" ]; then
    # A fast-forward from a release branch is how a bot closes a PR. Allow
    # exactly that, and nothing else.
    if [ "$_local_sha" = "$ZERO" ]; then continue; fi   # branch deletion
    refuse "a direct push to main (RULES/06).
  main receives work by merge or PR. The production path is main -> validated,
  and a push straight to main makes 'what is live' a question with two answers.
  If you are closing a pull request, merge it on the forge instead - that is a
  fast-forward and this hook will allow it.
  To override deliberately:  AIGF_ALLOW_MAIN_PUSH=1 git push ..."
    FAIL=1
  fi

  # -- RULES/06: validated is the only branch that serves the public, so a push
  # -- to it is a deploy announcement. It must be a commit main already has.
  if [ "$BRANCH" = "validated" ] && [ "$_local_sha" != "$ZERO" ]; then
    if ! git fetch --quiet origin 2>/dev/null; then :; fi
    if git rev-parse --verify origin/main >/dev/null 2>&1; then
      if ! git merge-base --is-ancestor "$_local_sha" origin/main 2>/dev/null; then
        refuse "this push would put a commit on validated that main does not have (RULES/06).
  validated is what the server pulls. Anything reaching it must have passed
  through main first:
    git checkout main && git merge <branch> && git push origin main
    bash bin/promote-to-validated.sh"
        FAIL=1
      fi
    fi
  fi

  # -- A force push to a permanent branch is how a stranger's work disappears.
  if [ "$_remote_sha" != "$ZERO" ] && [ "$ALLOW_FORCE" != "1" ]; then
    if ! git merge-base --is-ancestor "$_remote_sha" "$_local_sha" 2>/dev/null; then
      case "$BRANCH" in
        main|validated|master|develop)
          refuse "a force push to '$BRANCH' would discard commits that are already there.
  A permanent branch is history, not a variable. If something must be undone,
  append a correcting commit - that is what RULES/04-the-record.md is for.
  To override deliberately:  AIGF_ALLOW_FORCE_PUSH=1 git push --force ..."
          FAIL=1 ;;
      esac
    fi
  fi
done

[ "$FAIL" = "0" ] && exit 0
say ""
say "${YEL}Nothing was pushed.${OFF}"
exit 1
